<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ai_harness_deny</RootNamespace>
    <AssemblyName>ai-harness-deny</AssemblyName>
    <!-- baselib はホスト(ai-harness-main)が共有ロードするため、出力にコピーしない。 -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ai-harness-baselib\ai-harness-baselib\ai-harness-baselib.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!-- 各プロジェクトの .claude/rules へ配布する rule 本文。CopyRule が末尾 .rule.md の埋め込みを配置する。 -->
  <!-- 有効化時に無ければ置くデフォルト設定。CopyDefaultConfig が末尾 .config.yml の埋め込みを配置する。 -->
  <ItemGroup>
    <EmbeddedResource Include="deny.rule.md" />
    <EmbeddedResource Include="deny.config.yml" />
  </ItemGroup>

</Project>
